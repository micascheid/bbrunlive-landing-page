---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Delete Your Account - BB Run Live" description="Instructions for deleting your BB Run Live account and personal data.">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="py-4 px-6 border-b border-divider">
      <nav class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <img src="/icon.png" alt="BB Run Live" class="w-10 h-10 rounded-lg" />
          <span class="text-xl font-bold text-text-primary">BB Run Live</span>
        </a>
        <a 
          href="/" 
          class="text-text-secondary hover:text-text-primary transition-colors text-sm"
        >
          ← Back to Home
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1 px-6 py-12">
      <article class="max-w-2xl mx-auto">
        <div class="text-center mb-10">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-error/10 mb-6">
            <svg class="w-8 h-8 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold text-text-primary">Delete Your Account</h1>
        </div>

        <div class="bg-card rounded-2xl p-8 border border-divider mb-8">
          <p class="text-text-secondary mb-6 leading-relaxed">
            To delete your BB Run Live account and all associated data, follow these steps:
          </p>
          
          <ol class="space-y-4 mb-8">
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-info font-semibold">1</span>
              <span class="text-text-secondary pt-1">Open the <strong class="text-text-primary">BB Run Live</strong> app</span>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-info font-semibold">2</span>
              <span class="text-text-secondary pt-1">Go to the <strong class="text-text-primary">"More"</strong> tab</span>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-info font-semibold">3</span>
              <span class="text-text-secondary pt-1">Tap on your <strong class="text-text-primary">profile/account info</strong> at the top</span>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-info font-semibold">4</span>
              <span class="text-text-secondary pt-1">Select <strong class="text-text-primary">"Delete Account"</strong></span>
            </li>
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-surface flex items-center justify-center text-info font-semibold">5</span>
              <span class="text-text-secondary pt-1">Confirm the deletion</span>
            </li>
          </ol>

          <div class="bg-surface rounded-xl p-4 border border-divider">
            <p class="text-text-secondary text-sm">
              <strong class="text-text-primary">What gets deleted:</strong> Your account and all personal data (name, email) will be permanently removed from our systems.
            </p>
          </div>
        </div>

        <div class="bg-card rounded-2xl p-8 border border-divider">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Need Help?
          </h2>
          <p class="text-text-secondary">
            If you're unable to access the app or need assistance with account deletion, please contact us at:
          </p>
          <a 
            href="mailto:mica@bearbyteapps.com" 
            class="inline-flex items-center gap-2 text-info hover:text-info/80 transition-colors mt-3"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            mica@bearbyteapps.com
          </a>
        </div>

      </article>
    </main>

    <!-- Footer -->
    <footer class="py-6 px-6 border-t border-divider">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-text-tertiary">
        <p>&copy; {new Date().getFullYear()} BB Run Live. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/privacy" class="hover:text-text-secondary transition-colors">Privacy Policy</a>
          <a href="/" class="hover:text-text-secondary transition-colors">Home</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
