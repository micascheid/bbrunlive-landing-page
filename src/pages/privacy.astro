---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy - BB Run Live" description="Privacy Policy for BB Run Live mobile application">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="py-4 px-6 border-b border-divider">
      <nav class="max-w-4xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
          <img src="/icon.png" alt="BB Run Live" class="w-10 h-10 rounded-lg" />
          <span class="text-xl font-bold text-text-primary">BB Run Live</span>
        </a>
        <a 
          href="/" 
          class="text-text-secondary hover:text-text-primary transition-colors text-sm"
        >
          ← Back to Home
        </a>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1 px-6 py-12">
      <article class="max-w-3xl mx-auto prose-custom">
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-2">Privacy Policy</h1>
        <p class="text-text-tertiary mb-8">Last Updated: May 19, 2026</p>
        
        <p class="text-text-secondary mb-8 leading-relaxed">
          BB Run Live ("we," "our," or "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, and protect your information when you use our mobile application (the "App").
        </p>

        <!-- Section 1 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">1.</span> Information We Collect
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider space-y-6">
            <div>
              <h3 class="text-lg font-medium text-text-primary mb-3">Account Information</h3>
              <p class="text-text-secondary mb-3">When you create an account, we collect:</p>
              <ul class="list-disc list-inside text-text-secondary space-y-1 ml-2">
                <li>First name</li>
                <li>Last name</li>
                <li>Email address</li>
                <li>Password (stored securely in encrypted/hashed form)</li>
              </ul>
              <p class="text-text-secondary mt-3">
                If you sign in using Google or Apple, we receive your name and email address from those services. Apple users may choose to hide their email address using Apple's private relay service.
              </p>
            </div>

            <div class="border-t border-divider pt-6">
              <h3 class="text-lg font-medium text-text-primary mb-3">Feedback and Bug Reports</h3>
              <p class="text-text-secondary mb-3">When you submit feedback or bug reports through the App, we collect:</p>
              <ul class="list-disc list-inside text-text-secondary space-y-1 ml-2">
                <li>Your name</li>
                <li>Your email address</li>
                <li>The content of your feedback or report</li>
              </ul>
            </div>

            <div class="border-t border-divider pt-6">
              <h3 class="text-lg font-medium text-text-primary mb-3">Automatically Collected Information</h3>
              <p class="text-text-secondary">
                The App does not collect location data, device identifiers, or usage analytics beyond what Apple and Google may collect through their respective app stores and operating systems.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 2 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">2.</span> How We Use Your Information
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary mb-3">We use the information we collect to:</p>
            <ul class="list-disc list-inside text-text-secondary space-y-2 ml-2">
              <li>Create and manage your account</li>
              <li>Authenticate your access to the App</li>
              <li>Respond to your feedback and bug reports</li>
              <li>Improve the App's functionality and user experience</li>
            </ul>
          </div>
        </section>

        <!-- Section 3 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">3.</span> Data Storage and Security
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary mb-4">
              Your data is stored securely using Supabase, a trusted database service, hosted in the United States (US-West region). We implement appropriate technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction.
            </p>
            <p class="text-text-secondary">
              Passwords are never stored in plain text and are cryptographically hashed.
            </p>
          </div>
        </section>

        <!-- Section 4 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">4.</span> Data Sharing
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary mb-4">
              We do not sell, trade, or rent your personal information to third parties.
            </p>
            <p class="text-text-secondary mb-3">Your information may be shared only in the following circumstances:</p>
            <ul class="space-y-3 text-text-secondary ml-2">
              <li><strong class="text-text-primary">Service Providers:</strong> We use Supabase to store and manage user data securely.</li>
              <li><strong class="text-text-primary">Authentication Providers:</strong> If you use Google or Apple Sign-In, those services process your authentication according to their respective privacy policies.</li>
              <li><strong class="text-text-primary">Legal Requirements:</strong> We may disclose your information if required by law or in response to valid legal requests.</li>
            </ul>
          </div>
        </section>

        <!-- Section 5 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">5.</span> Your Rights and Choices
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider space-y-6">
            <div>
              <h3 class="text-lg font-medium text-text-primary mb-3">Account Deletion</h3>
              <p class="text-text-secondary mb-3">You can delete your account and all associated data at any time through the App:</p>
              <ol class="list-decimal list-inside text-text-secondary space-y-1 ml-2">
                <li>Go to the "More" tab</li>
                <li>Tap on your account information</li>
                <li>Select "Delete Account"</li>
              </ol>
              <p class="text-text-secondary mt-3">
                Upon deletion, all your personal data will be permanently removed from our systems.
              </p>
            </div>

            <div class="border-t border-divider pt-6">
              <h3 class="text-lg font-medium text-text-primary mb-3">Data Access</h3>
              <p class="text-text-secondary">
                You may contact us to request access to the personal information we hold about you.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 6 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">6.</span> Children's Privacy
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary">
              The App is not intended for children under the age of 13. We do not knowingly collect personal information from children under 13. If you believe we have collected information from a child under 13, please contact us immediately.
            </p>
          </div>
        </section>

        <!-- Section 7 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">7.</span> Third-Party Links
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary">
              The App may contain links to external websites (such as the Photo Contest page). We are not responsible for the privacy practices of these external sites. We encourage you to review the privacy policies of any third-party sites you visit.
            </p>
          </div>
        </section>

        <!-- Section 8 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">8.</span> Changes to This Privacy Policy
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary">
              We may update this Privacy Policy from time to time. Any changes will be reflected on this page with an updated "Last Updated" date. We encourage you to review this policy periodically.
            </p>
          </div>
        </section>

        <!-- Section 9 -->
        <section class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4 flex items-center gap-2">
            <span class="text-info">9.</span> Contact Us
          </h2>
          
          <div class="bg-card rounded-xl p-6 border border-divider">
            <p class="text-text-secondary mb-4">
              If you have any questions about this Privacy Policy or wish to exercise your data rights, please contact us at:
            </p>
            <a 
              href="mailto:mica@bearbyteapps.com" 
              class="inline-flex items-center gap-2 text-info hover:text-info/80 transition-colors text-lg"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              mica@bearbyteapps.com
            </a>
          </div>
        </section>

      </article>
    </main>

    <!-- Footer -->
    <footer class="py-6 px-6 border-t border-divider">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-text-tertiary">
        <p>&copy; {new Date().getFullYear()} BB Run Live. All rights reserved.</p>
        <a 
          href="/" 
          class="hover:text-text-secondary transition-colors"
        >
          Home
        </a>
      </div>
    </footer>
  </div>
</Layout>
